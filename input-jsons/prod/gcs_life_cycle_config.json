{
  "base_name": "basic-lifecycle-bucket",
  "location": "US-EAST1",
  "storage_class": "STANDARD",
  "force_destroy": true,
  "labels": {
    "managed_by": "terraform",
    "environment": "prod"
  },
  "versioning": {
    "enabled": true
  },
  "lifecycle_rule": [
    {
      "action": { "type": "SetStorageClass", "storage_class": "NEARLINE" },
      "condition": { "age": 30 }
    },
    {
      "action": { "type": "SetStorageClass", "storage_class": "COLDLINE" },
      "condition": { "age": 90 }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 365 }
    }
  ]
}
